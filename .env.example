# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (authorized callback: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (authorized callback: http://localhost:3000/api/auth/oauth2/callback/microsoft-entra-id)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "common" for work, school, and personal Microsoft accounts.
MICROSOFT_TENANT_ID=common

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Web Push (generate the key pair with `pnpm push:keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Bearer token used by the external minute-level notification scheduler
CRON_SECRET=replace-with-a-random-scheduler-secret
