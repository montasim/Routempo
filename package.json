{
  "name": "routempo-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "web:dev": "pnpm --filter @routempo/web dev",
    "web:build": "pnpm --filter @routempo/web build",
    "web:start": "pnpm --filter @routempo/web start",
    "web:typecheck": "pnpm --filter @routempo/web typecheck",
    "web:test": "pnpm --filter @routempo/web test",
    "web:test:e2e": "pnpm --filter @routempo/web test:e2e",
    "web:db:generate": "pnpm --filter @routempo/web db:generate",
    "web:db:migrate": "pnpm --filter @routempo/web db:migrate",
    "web:db:studio": "pnpm --filter @routempo/web db:studio",
    "web:push:keys": "pnpm --filter @routempo/web push:keys",
    "web:format": "pnpm --filter @routempo/web format",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.1"
  }
}
